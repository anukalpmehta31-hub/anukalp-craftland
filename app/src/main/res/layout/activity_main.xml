<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7FB">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:text="ANUKALP CRAFTLAND" android:textStyle="bold" android:textSize="22sp" android:textColor="#111827" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Maps • Assets" android:textColor="#6B7280" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/authPanel" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
<EditText android:id="@+id/email" android:hint="Owner email" android:inputType="textEmailAddress" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/password" android:hint="Password" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/loginBtn" android:text="Owner Login" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:id="@+id/adminPanel" android:orientation="vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
<TextView android:text="OWNER ADMIN" android:textStyle="bold" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/typeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/title" android:hint="Title" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/creator" android:hint="Creator" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/code" android:hint="Map / Asset Code" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/description" android:hint="Description" android:minLines="3" android:gravity="top" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/addBtn" android:text="Add Listing" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/logoutBtn" android:text="Logout" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView android:id="@+id/status" android:textColor="#667085" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="PUBLIC LISTINGS" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/listContainer" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
